<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Theme cho toàn ứng dụng -->
    <style name="Theme.iBTC" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bitcoin_orange</item>
        <item name="colorPrimaryVariant">@color/bitcoin_orange_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:statusBarColor">@color/bitcoin_orange_dark</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:colorAccent">@color/bitcoin_orange</item>
    </style>

    <!-- Theme cho AlertDialog (để tùy chỉnh màu nút) -->
    <style name="AlertDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:background">@drawable/dialog_background</item>
        <item name="android:titleTextColor">@color/bitcoin_orange</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>